<?xml version="1.0"?>
<launch>
    <node pkg="imu_data_fusion" type="imu_data_fusion_node" name="imu_data_fusion" output="screen">
        <param name="time_sync_tolerance" value="0.01" />
        <param name="output_frame" value="imu_link" />
        <remap from="/imu/data_raw" to="/imu/data_raw" />
        <remap from="/bynav/inspvax" to="/bynav/inspvax" />
        <remap from="/imu_data" to="/imu_data" />
    </node>
</launch>
