<launch>
    <!-- 点云转2D激光扫描(用于避障) -->
    <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan">
        <remap from="cloud_in" to="/velodyne_points"/>
        <remap from="scan" to="/scan"/>
        <rosparam>
            target_frame: base_link
            transform_tolerance: 0.5
            min_height: -0.2
            max_height: 0.5
            angle_min: -3.14159
            angle_max: 3.14159
            angle_increment: 0.01745  # 1度
            scan_time: 0.1
            range_min: 0.5
            range_max: 50.0
            use_inf: true
        </rosparam>
    </node>

    <!-- Move Base 导航 -->
    <node pkg="move_base" type="move_base" name="move_base" output="screen">
        <!-- 局部代价地图 -->
        <rosparam>
            base_local_planner: dwa_local_planner/DWAPlannerROS
            
            # 全局代价地图(滚动窗口)
            global_costmap:
                global_frame: base_link
                robot_base_frame: base_link
                update_frequency: 2.0
                publish_frequency: 1.0
                static_map: false
                rolling_window: true
                width: 30.0
                height: 30.0
                resolution: 0.1
                transform_tolerance: 1.0
                obstacle_range: 10.0
                raytrace_range: 12.0
                footprint: [[-0.13, -0.084], [-0.13, 0.084], [0.13, 0.084], [0.13, -0.084]]
                inflation_radius: 0.3
                cost_scaling_factor: 10.0
                observation_sources: scan
                scan:
                    data_type: LaserScan
                    topic: /scan
                    marking: true
                    clearing: true
            
            # 局部代价地图
            local_costmap:
                global_frame: base_link
                robot_base_frame: base_link
                update_frequency: 5.0
                publish_frequency: 2.0
                static_map: false
                rolling_window: true
                width: 3.0
                height: 3.0
                resolution: 0.05
                transform_tolerance: 0.5
                obstacle_range: 5.0
                raytrace_range: 6.0
                footprint: [[-0.13, -0.084], [-0.13, 0.084], [0.13, 0.084], [0.13, -0.084]]
                inflation_radius: 0.3
                cost_scaling_factor: 5.0
                observation_sources: scan
                scan:
                    data_type: LaserScan
                    topic: /scan
                    marking: true
                    clearing: true
            
            # DWA局部规划器参数
            DWAPlannerROS:
                # 速度限制
                max_vel_x: 2.0
                min_vel_x: 0.1
                max_vel_theta: 1.5
                min_vel_theta: 0.4
                
                # 加速度限制
                acc_lim_x: 2.0
                acc_lim_y: 0.0
                acc_lim_theta: 2.0
                
                # 目标容差
                xy_goal_tolerance: 0.3
                yaw_goal_tolerance: 0.2
                latch_xy_goal_tolerance: false
                
                # 前向模拟
                sim_time: 2.0
                sim_granularity: 0.025
                vx_samples: 10
                vy_samples: 0
                vth_samples: 20
                
                # 轨迹评分
                path_distance_bias: 32.0
                goal_distance_bias: 20.0
                occdist_scale: 0.02
                forward_point_distance: 0.325
                stop_time_buffer: 0.2
                scaling_speed: 0.25
                max_scaling_factor: 0.2
                
            # Move Base参数
            controller_frequency: 5.0
            planner_patience: 5.0
            controller_patience: 15.0
            conservative_reset_dist: 3.0
            planner_frequency: 0.5
            oscillation_timeout: 10.0
            oscillation_distance: 0.2
        </rosparam>
    </node>

    <!-- cmd_vel转Ackermann控制 -->
    <node name="nav_sim" pkg="racecar_description" type="nav_sim.py" output="screen"/>

</launch>
