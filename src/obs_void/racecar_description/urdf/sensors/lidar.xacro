<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lidar">

    <!-- Include VLP-16 from velodyne_description -->
    <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro"/>

    <xacro:macro name="lidar" params="prefix:=laser">
        <!-- Use VLP-16 3D LiDAR instead of 2D lidar -->
        <!-- The VLP-16 macro creates its own base_link and sensor link structure -->
        <!-- We create a dummy link with the old name for compatibility -->
        <link name="${prefix}_link">
            <inertial>
                <mass value="0.001" />
                <origin xyz="0 0 0" />
                <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                         iyy="0.001" iyz="0.0"
                         izz="0.001" />
            </inertial>
        </link>

        <!-- Mount VLP-16 on the laser_link -->
        <xacro:VLP-16 parent="${prefix}_link" name="velodyne" topic="/velodyne_points" 
                      organize_cloud="false" hz="10" lasers="16" samples="1875" 
                      collision_range="0.3" min_range="0.9" max_range="130.0" 
                      noise="0.008" gpu="false">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:VLP-16>

    </xacro:macro>

</robot>
